# Nur die Endpunkte sind von außen erreichbar; Logik, Zugangsdaten und Bestellungen nicht.
<FilesMatch "^(lib|config|config\.example)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
