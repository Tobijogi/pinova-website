# Alle Aufrufe auf https://www.pinovalab.eu leiten (http → https, pinovalab.eu → www).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://www.pinovalab.eu%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^pinovalab\.eu$ [NC]
  RewriteRule ^ https://www.pinovalab.eu%{REQUEST_URI} [R=301,L]
</IfModule>

# HTML-Seiten bei jedem Aufruf neu prüfen lassen, damit Änderungen sofort sichtbar sind
# (ohne diese Angabe halten Browser die Seite nach eigenem Ermessen im Zwischenspeicher).
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Schriften ändern sich nie, Bilder, Skripte und Styles selten.
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|webp|svg|css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Textdateien komprimiert ausliefern (schnelleres Laden, auch für Google wichtig).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>
